<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MantenimientoCapilar.Pages.CalibracionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Calibración" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Certificados de comparación contra patrón. CAL-2026-018 es el ejemplo del termómetro de folículos."
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Click="ExportarLista_Click" Content="Exportar PDF" />
                <Button Click="Nueva_Click" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                        <TextBlock Text="Nueva calibración" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="Lista"
                ItemContainerStyle="{StaticResource FilaListaEstilo}"
                ItemTemplate="{StaticResource FilaPlantilla}"
                ItemsSource="{x:Bind Filas}"
                SelectionChanged="Lista_SelectionChanged" />

            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="DetalleVacio"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Selecciona un certificado." />
                    <StackPanel x:Name="Detalle" Spacing="12" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="Codigo" Style="{StaticResource EtiquetaCampo}" />
                            <TextBlock x:Name="Titulo" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="EquipoLinea"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar x:Name="ResultadoAviso" IsClosable="False" IsOpen="False" />

                        <Border Style="{StaticResource Tarjeta}">
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource EtiquetaCampo}" Text="Fecha" />
                                    <TextBlock x:Name="FechaTexto" IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource EtiquetaCampo}" Text="Próxima calibración" />
                                    <TextBlock x:Name="ProximaTexto" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="2">
                                    <TextBlock Style="{StaticResource EtiquetaCampo}" Text="Responsable" />
                                    <TextBlock x:Name="Tecnico" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                    <TextBlock Style="{StaticResource EtiquetaCampo}" Text="Criterio" />
                                    <TextBlock x:Name="Criterio" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2">
                                    <TextBlock Style="{StaticResource EtiquetaCampo}" Text="Condiciones" />
                                    <TextBlock x:Name="Condiciones" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Patrón" />
                                <TextBlock x:Name="TextoPatron" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock x:Name="CertificadoPatron" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}" Padding="0">
                            <StackPanel>
                                <TextBlock Margin="16,16,16,8" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Puntos de comparación" />
                                <Grid Padding="16,10,16,10" Background="{ThemeResource SubtleFillColorSecondaryBrush}" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource EtiquetaCampo}" Text="Punto" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource EtiquetaCampo}" Text="Patrón" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource EtiquetaCampo}" Text="Lectura" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource EtiquetaCampo}" Text="Error" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource EtiquetaCampo}" Text="Tolerancia" />
                                    <TextBlock Grid.Column="5" Style="{StaticResource EtiquetaCampo}" Text="Dictamen" />
                                </Grid>
                                <ItemsControl x:Name="TablaPuntos">
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="16,10"
                                                Background="{Binding Fondo}"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="160" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Nombre}" TextWrapping="Wrap" />
                                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Patron}" />
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Lectura}" />
                                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ErrorMedida}" />
                                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Tolerancia}" />
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding ColorDictamen}"
                                                        Text="{Binding Dictamen}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Margin="16,8,16,16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="Error = lectura del instrumento menos el valor del patrón. Conforme si el valor absoluto no supera la tolerancia."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Procedimiento" />
                                <TextBlock x:Name="Procedimiento" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tarjeta}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{ThemeResource SubtitleTextBlockStyle}" Text="Observaciones" />
                                <TextBlock x:Name="Observaciones" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="ExportarCertificado_Click" Content="Exportar este certificado" />
                            <HyperlinkButton x:Name="VerEquipo" VerticalAlignment="Center" Click="VerEquipo_Click" Content="Ver ficha del equipo" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
