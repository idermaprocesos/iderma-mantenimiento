<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MantenimientoCapilar.Pages.InicioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <Grid Padding="32,24,32,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Seguimiento operativo" />
            <TextBlock
                x:Name="Subtitulo"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Extracción, implantación, esterilización y cadena de frío."
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            x:Name="Aviso"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="Operativos_Click" Style="{StaticResource BotonTarjeta}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CifraOperativos" Style="{ThemeResource TitleLargeTextBlockStyle}" Text="0" />
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Equipos operativos" />
                    <TextBlock
                        x:Name="NotaOperativos"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Click="Vencidos_Click" Style="{StaticResource BotonTarjeta}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CifraVencidos" Style="{ThemeResource TitleLargeTextBlockStyle}" Text="0" />
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Mantenimientos vencidos" />
                    <TextBlock
                        x:Name="NotaVencidos"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Click="Calibracion_Click" Style="{StaticResource BotonTarjeta}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CifraCalibracion" Style="{ThemeResource TitleLargeTextBlockStyle}" Text="0" />
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Calibraciones en alerta" />
                    <TextBlock
                        x:Name="NotaCalibracion"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Click="Semana_Click" Style="{StaticResource BotonTarjeta}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CifraSemana" Style="{ThemeResource TitleLargeTextBlockStyle}" Text="0" />
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Programados en 7 días" />
                    <TextBlock
                        x:Name="NotaSemana"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Tarjeta}" Padding="8">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,8,8,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Órdenes abiertas" />
                    <ListView
                        x:Name="ListaOrdenes"
                        Grid.Row="1"
                        Background="Transparent"
                        IsItemClickEnabled="True"
                        ItemClick="Ordenes_ItemClick"
                        ItemContainerStyle="{StaticResource FilaListaEstilo}"
                        ItemTemplate="{StaticResource FilaPlantilla}"
                        SelectionMode="None" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Padding="8">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,8,8,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Calibración de equipos críticos" />
                    <ListView
                        x:Name="ListaCalibraciones"
                        Grid.Row="1"
                        Background="Transparent"
                        IsItemClickEnabled="True"
                        ItemClick="Calibraciones_ItemClick"
                        ItemContainerStyle="{StaticResource FilaListaEstilo}"
                        ItemTemplate="{StaticResource FilaPlantilla}"
                        SelectionMode="None" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
